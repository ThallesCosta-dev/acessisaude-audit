# Dados gerados pela ferramenta
data/scans/*
data/exports/*
!data/scans/.gitkeep
!data/exports/.gitkeep
*.sqlite
*.sqlite3
*.db
# Journal WAL do SQLite: arquivos voláteis do modo write-ahead logging,
# criados ao lado do banco e sem valor de arquivamento.
*.sqlite-shm
*.sqlite-wal
*.db-shm
*.db-wal

# Artefatos de análise
docs/artigo/figuras/*.png
docs/artigo/figuras/*.svg
!docs/artigo/figuras/.gitkeep

